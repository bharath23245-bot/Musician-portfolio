{
  "entities": {
    "AdminAccount": {
      "title": "AdminAccount",
      "description": "Administrator account credentials and profile stored in dedicated table",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "name": { "type": "string", "maxLength": 100 },
        "passwordHash": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["admin", "superadmin"] },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["email", "passwordHash", "name"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Artist booking inquiry proposal submitted by prospective clients or event coordinators",
      "type": "object",
      "properties": {
        "client": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Customer / Organization Name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150,
          "description": "Customer Contact Email"
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Customer Contact Phone Number"
        },
        "eventType": {
          "type": "string",
          "maxLength": 80,
          "description": "Type of event (Live Performance, Concert, Recital, etc.)"
        },
        "date": {
          "type": "string",
          "maxLength": 50,
          "description": "Requested event date"
        },
        "location": {
          "type": "string",
          "maxLength": 100,
          "description": "Event City / Location"
        },
        "venue": {
          "type": "string",
          "maxLength": 150,
          "description": "Event Venue Name"
        },
        "budget": {
          "type": "string",
          "maxLength": 80,
          "description": "Estimated budget tier"
        },
        "message": {
          "type": "string",
          "maxLength": 2000,
          "description": "Project notes and acoustic details"
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Confirmed", "Declined", "Completed"],
          "description": "Current status of inquiry"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO date string when inquiry was created"
        }
      },
      "required": ["client", "email", "date", "status"]
    },
    "Track": {
      "title": "Track",
      "description": "Discography track release",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 120 },
        "subtitle": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "maxLength": 50 },
        "duration": { "type": "string", "maxLength": 20 },
        "plays": { "type": "number" },
        "coverUrl": { "type": "string" },
        "releaseDate": { "type": "string" }
      },
      "required": ["title", "category"]
    },
    "Event": {
      "title": "Event",
      "description": "Upcoming concert tour date or recital",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 120 },
        "venue": { "type": "string", "maxLength": 120 },
        "location": { "type": "string", "maxLength": 100 },
        "month": { "type": "string", "maxLength": 20 },
        "day": { "type": "string", "maxLength": 10 },
        "fullDate": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Upcoming", "Sold Out", "Completed"] }
      },
      "required": ["title", "venue", "location"]
    },
    "Profile": {
      "title": "Profile",
      "description": "Public artist persona and contact profile",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "tagline": { "type": "string", "maxLength": 200 },
        "quote": { "type": "string", "maxLength": 300 },
        "email": { "type": "string", "format": "email" },
        "notificationEmail": { "type": "string", "format": "email" },
        "phone": { "type": "string" }
      },
      "required": ["name", "email"]
    }
  },
  "firestore": {
    "/admin_accounts/{adminId}": {
      "schema": "AdminAccount",
      "description": "Dedicated collection for administrative login accounts and credentials"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Client proposals and booking inquiries"
    },
    "/tracks/{trackId}": {
      "schema": "Track",
      "description": "Artist discography tracks and audio works"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Upcoming live performances and tour dates"
    },
    "/profile/{profileId}": {
      "schema": "Profile",
      "description": "Artist management and biography details"
    }
  }
}
